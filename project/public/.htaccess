# Apache .htaccess 301 Redirects & Clean URLs
RewriteEngine On
RewriteBase /

# 1. Redirect explicit .html requests to clean URLs with 301 Moved Permanently
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.html[^\s]* [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([^.]+)\.html[^\s]* [NC]
RewriteRule ^%1$ [R=301,L]

# 2. Internally resolve clean URLs to .html files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]
